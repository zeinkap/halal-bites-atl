# Copy to .env.test (gitignored) and fill in. Playwright always loads .env.test and refuses to
# run unless the database name in DATABASE_URL equals ALLOWED_TEST_DB (tests/utils/db-guard.ts).
# Tests create and delete real rows, so use a dedicated test database, never production.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require
ALLOWED_TEST_DB=DB_NAME
